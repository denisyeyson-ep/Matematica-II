---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { portfolio } from '../config/portfolio';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Portafolio Académico de Matemática',
  description = portfolio.description,
} = Astro.props;
const pageTitle = title === 'Portafolio Académico de Matemática'
  ? title
  : title + ' | ' + portfolio.course;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1120" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('portafolio-theme');
          const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = stored || system;
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body>
    <a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>
    <Header />
    <main id="contenido-principal"><slot /></main>
    <Footer />
    <SearchDialog />
  </body>
</html>
